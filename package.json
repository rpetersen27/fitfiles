{
  "name": "fitfiles-cli",
  "version": "0.1.0",
  "description": "CLI for analyzing cycling FIT files overall and per section.",
  "type": "module",
  "bin": {
    "fit-analyze": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:web",
    "build:cli": "tsc --project tsconfig.json",
    "build:web": "vite build",
    "check": "npm run build",
    "dev": "vite",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "fit",
    "cycling",
    "cli",
    "analysis"
  ],
  "license": "MIT",
  "dependencies": {
    "fit-file-parser": "^1.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
